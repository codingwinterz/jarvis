[TEMPLATE]
# EDITH — example environment file
# ===================================================================
# The brain talks to free OpenAI-compatible providers. EVERYTHING HERE IS
# OPTIONAL in the sense that nothing is billed to you — but with no provider
# key at all, every question fails. The one line worth adding is a provider
# key, below.
#
# Two free keys, one or both:
#   GROQ_API_KEY     — console.groq.com   (fast tier: chitchat, instant answers)
#   NVIDIA_API_KEY   — build.nvidia.com   (smart tier: tool-heavy agentic turns)
#
# Both configured = the hybrid brain: conversation rides Groq's LPUs, tool
# work is promoted to Nemotron, and either provider catches the other's rate
# limits. One configured = that provider does everything, no routing.
# Never commit a real key.
#
# Two audiences read these variables:
# - the BRIDGE (the Node server, bridge/server.mjs) reads the JARVIS_*,
#   GROQ_*, NVIDIA_*, FISH_* and ELEVENLABS_* variables from .env.local at
#   boot (bridge/env.mjs), falling back to the shell environment. Values
#   already exported in the shell always win over the file.
# - the FRONTEND (the Vite app) reads the VITE_* variables from .env.local.
#   Only VITE_-prefixed values ever reach the browser.
# ===================================================================
# PROVIDERS (the bridge) — uncomment in .env.local (this file is a template)
# ===================================================================
# GROQ_API_KEY=
# (Groq's key also transcribes the mic — see JARVIS_STT_PROVIDER below.)
# NVIDIA_API_KEY=
#
# The models. Defaults are resolved against each provider's own catalogue at
# boot (a retired slug self-heals; on NVIDIA, the Nemotron 3 Super slug is
# picked when listed, falling back to Ultra). Set these to pin a model.
# JARVIS_GROQ_MODEL=llama-3.3-70b-versatile
# JARVIS_NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
#
# Routing:
#   hybrid   (default) — fast tier first; tool turns promoted to the smart
#                        tier; auto-escalation on rate limits and timeouts.
#   groq               — fast tier only.
#   nemotron           — smart tier only.
# JARVIS_ROUTING=hybrid
#
# With routing set to hybrid, JARVIS_ROUTE=smart-first inverts the promotion
# (smart tier carries the turn from the start; fast tier is the fallback).
# JARVIS_ROUTE=
# NOTE: Groq's free tier is ~8000 tokens/min — smaller than one turn that
# carries the tool schemas. With free-tier keys, smart-first is the reliable
# choice: the smart tier takes the turn, Groq stays the fallback (and still
# transcribes the mic).
#
# Nemotron generates a reasoning trace before answering. Off by default — a
# voice conversation cannot afford it. Set to 1 for heavy analytical demos.
# JARVIS_THINKING=0
#
# Cap on the model's reply length in tokens, and on tool round-trips per turn.
# Defaults are tuned for a spoken conversation.
# JARVIS_MAX_TOKENS=1024
# JARVIS_MAX_STEPS=16
#
# Port the bridge listens on (WebSocket + HTTP endpoints). Default 8787.
# If you change it, change VITE_BRIDGE_URL to match.
# JARVIS_BRIDGE_PORT=8787
#
# Allow effectful tools (send, tap, delete, install, pay). Off by default, so
# EDITH can look at anything and change nothing. `npm run bridge:writes`
# sets this to 1 for you — read the decideTool gate in bridge/server.mjs first.
# JARVIS_ALLOW_WRITES=0
#
# Extra browser origins allowed to open the agent WebSocket, comma separated.
# Local dev origins are already allowed. Default: none.
# JARVIS_ALLOWED_ORIGINS=
#
# Allow clients that send no Origin header at all (curl, scripts, native apps).
# Off by default, because that is also what local malware looks like. Default 0.
# JARVIS_ALLOW_NO_ORIGIN=0
#
# Extra directories the bridge's /file endpoint may serve from, comma separated.
# Your home directory and the system temp directory are always included.
# JARVIS_FILE_ROOTS=
#
# PIPEDREAM — credentials for the `pipedream` MCP server in bridge/edith.mcp.json
# (Gmail, GitHub and ~3,000 other apps through one endpoint). Create them at
# pipedream.com -> your project -> Settings (OAuth credentials + project id).
# The bridge mints and refreshes its own access token from these; nothing is
# pasted into edith.mcp.json. Also connect Gmail/GitHub inside the project
# (pipedream.com -> project -> Accounts) — chat.pipedream.com connections are
# a separate namespace.
# PIPEDREAM_CLIENT_ID=
# PIPEDREAM_CLIENT_SECRET=
# PIPEDREAM_PROJECT_ID=proj_xxxxxxx
# PIPEDREAM_ENVIRONMENT=development
# PIPEDREAM_EXTERNAL_USER_ID=edith
#
# GITHUB — the official GitHub MCP server (bridge/edith.mcp.json). No OAuth,
# no plan, no bill: one fine-grained personal access token, free forever.
# Create it at https://github.com/settings/personal-access-tokens
#   -> Generate new token -> name it (e.g. edith)
#   -> Resource owner: yourself; Repository access: only the repos you want
#   -> Permissions: Repository -> Contents = Read-only (add Pull requests
#      = Read and write only if you want EDITH to open PRs — and only run
#      that bridge with `npm run bridge:writes`)
#   -> Generate, copy the github_pat_… value, paste it here, restart the bridge
# The github entry references this variable as ${GITHUB_MCP_PAT}; the token
# never sits in edith.mcp.json (which is tracked). With this unset, the github
# MCP server stays off and the boot log says so — nothing else breaks.
# GITHUB_MCP_PAT=
#
# ElevenLabs voice id. Default: George.
# JARVIS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
#
# ElevenLabs API key. Optional. With it, EDITH speaks in the ElevenLabs voice
# and transcribes with ElevenLabs Scribe; without it, everything still works on
# the browser's own speech. Default: none.
# ELEVENLABS_API_KEY=
# ===================================================================
# Fish Audio (fish.audio) — a custom voice with their free flagship model.
# Create a voice in the Voice Lab, copy its reference id, and get an API key
# from fish.audio (API Keys). When key + voice are both set, /tts speaks
# through Fish automatically; set JARVIS_TTS_PROVIDER=elevenlabs to force
# the other engine instead. STT stays on Groq Whisper or the browser — Fish is
# speaker-out only.
# FISH_API_KEY=
# FISH_VOICE_ID=
# Which Fish model (header). Unrecognized values silently fall back to the
# PAID s2.1-pro — keep the free tier pinned unless you have credits.
# FISH_MODEL=s2.1-pro-free
# Latency/quality trade-off: low | balanced (default) | normal.
# FISH_LATENCY=balanced
# Force a provider explicitly instead of the auto preference (fish|elevenlabs).
# JARVIS_TTS_PROVIDER=
# Which engine transcribes the mic (the /stt input side). Auto: Groq Whisper
# when GROQ_API_KEY is set (free — roughly 2000 transcription requests a day),
# else ElevenLabs Scribe, else the browser's own recogniser.
# JARVIS_STT_PROVIDER=groq|elevenlabs
# Which Whisper model when Groq is transcribing.
# JARVIS_STT_MODEL=whisper-large-v3-turbo
# ===================================================================
# FRONTEND (Vite) — put these in .env.local
# ===================================================================
# Which brain the browser talks to. Default bridge.
#   bridge — talk to the local bridge (recommended). Full tool surface.
#   direct — the browser calls an OpenAI-compatible provider itself.
#            Conversation only; needs VITE_PROVIDER_API_KEY.
# VITE_BACKEND=bridge
# Where the bridge listens. Keep the port in step with JARVIS_BRIDGE_PORT.
# Default ws://localhost:8787.
# VITE_BRIDGE_URL=ws://localhost:8787
#
# DIRECT MODE ONLY — the browser calls this provider itself.
# VITE_PROVIDER_API_KEY=
# VITE_DIRECT_BASE_URL=https://api.groq.com/openai/v1
#
# Browser text-to-speech engine, used when no ElevenLabs voice is active.
#   system — the browser's built-in speechSynthesis. Instant, on-device.
#   kokoro — a neural voice running in the browser. Better sound, slower start.
# VITE_TTS_ENGINE=system
# Which Kokoro voice, when VITE_TTS_ENGINE=kokoro. Default bm_george.
# VITE_KOKORO_VOICE=bm_george
# Prefer the ElevenLabs voice from the browser when a key is available.
# Default false.
# VITE_USE_ELEVENLABS=false
